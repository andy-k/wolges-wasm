from rust:1.99.1

run ["cargo", "install", "wasm-pack", "--locked"]
run ["rustup", "target", "add", "wasm32-unknown-unknown"]

workdir /workdir

# cargo works in the container's own /target, not in the shared directory: on
# a directory shared from a Mac, Docker Desktop keeps only the whole seconds
# of a time set on a file that already exists, so the files a build script
# had just written looked newer than its last run, and the next builds ran
# the build scripts again and compiled again all that depends on them, one
# of them now and then stopping on a crate it could not find. Each build
# compiles its crates afresh
env CARGO_TARGET_DIR=/target

# panic messages carry source paths: name this container's the same as a
# build anywhere else would, /target as the shared directory's target
env RUSTFLAGS="--remap-path-prefix=/usr/local/cargo/registry/src=/cargo --remap-path-prefix=/workdir=/wolges-wasm --remap-path-prefix=/target=/wolges-wasm/target"

# the build reads its commits with git, which refuses a repository another
# user owns, as a mounted one is on a Linux host
run ["git", "config", "--system", "--add", "safe.directory", "*"]

copy --chmod=755 <<'EOF' /usr/local/bin/build-packages
#!/usr/bin/env bash
set -euo pipefail
# wasm-pack lists in package.json's "files" only the license files the out
# directory holds as it writes package.json, and it copies the crate's there
# afterward: a first build in a fresh tree would leave LICENSE.txt out. So
# each out directory gets a copy first
for dir in pkg pkg-web; do
  mkdir -p "$dir"
  [ -e "$dir/LICENSE.txt" ] || cp -npv LICENSE.txt "$dir/"
done
# for webpack and deno
wasm-pack build
# wasm-opt takes most of a build, and both targets get the same wasm, so it
# runs once: the web build skips it and takes the bundler's output, after a
# third build (the bundler's without wasm-opt) shows that the two still match
wasm-pack build -t web -d pkg-web --no-opt
wasm-pack build -d /target/pkg-no-opt --no-opt
if ! cmp /target/pkg-no-opt/wolges_wasm_bg.wasm pkg-web/wolges_wasm_bg.wasm; then
  printf '%s\n' "the web target's wasm is not the bundler's: it needs its own wasm-opt" >&2
  exit 1
fi
rm pkg-web/wolges_wasm_bg.wasm
cp -npv pkg/wolges_wasm_bg.wasm pkg-web/
EOF

cmd ["build-packages"]
