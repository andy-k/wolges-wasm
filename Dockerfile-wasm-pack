from rust:1.99.1

run ["cargo", "install", "wasm-pack", "--locked"]
run ["rustup", "target", "add", "wasm32-unknown-unknown"]

workdir /workdir

# panic messages carry source paths: name this container's the same as a
# build anywhere else would
env RUSTFLAGS="--remap-path-prefix=/usr/local/cargo/registry/src=/cargo --remap-path-prefix=/workdir=/wolges-wasm"

# the build reads its commits with git, which refuses a repository another
# user owns, as a mounted one is on a Linux host
run ["git", "config", "--system", "--add", "safe.directory", "*"]

# for webpack and deno
cmd ["bash", "-c", "wasm-pack build && wasm-pack build -t web -d pkg-web"]
